<!--
  Flex ddG protocol (Barlow et al., J Phys Chem B 2018) for TCR-pMHC interfaces.

  Ported to match the Kortemme-Lab flex_ddG_tutorial reference XML verbatim in
  execution structure (github.com/Kortemme-Lab/flex_ddG_tutorial/blob/master/ddG-backrub.xml),
  since two wiring details are load-bearing and easy to get wrong by "simplifying":
    1. InterfaceDdGMover MUST carry db_reporter="dbreport": that attribute is what
       clones `dbreport` (the ReportToDB writing ddG.db3) four times internally (once
       each for bound_wt/unbound_wt/bound_mut/unbound_mut) and applies each clone.
       Without it, ddG.db3 is never created at all (no error, just missing output).
    2. `finish_ddg_post_backrub` (the ParsedProtocol containing repack/minimize/mutate/
       int_ddG_mover) MUST be wired in via BackrubProtocol's own
       trajectory_apply_mover="..." attribute, not via <PROTOCOLS><Add .../></PROTOCOLS>.
       A previous version of this file declared it as a mover but never invoked it from
       anywhere reachable, so the ddG computation silently never ran.

  Per-job script-vars (set on the rosetta_scripts command line; see
  run_flex_ddg.py): chainstomove, pathtoresfile, backrubntrials.

  Real output is read via structure_scores JOIN batches ON batch_id, matching on
  batches.name prefixes ("bound_wt_", "unbound_wt_", "bound_mut_", "unbound_mut_");
  see run_flex_ddg.py's parse_ddg_db3(). NOT via any structures.tag substring match.

  DO NOT run locally (this is launched on HPC via submit_array.sbatch).
-->
<ROSETTASCRIPTS>
  <SCOREFXNS>
    <ScoreFunction name="fa_talaris2014" weights="talaris2014"/>
    <ScoreFunction name="fa_talaris2014_cst" weights="talaris2014">
      <Reweight scoretype="atom_pair_constraint" weight="1.0"/>
      <Set fa_max_dis="9.0"/>
    </ScoreFunction>
  </SCOREFXNS>

  <TASKOPERATIONS>
    <ReadResfile name="mutate_resfile" filename="%%pathtoresfile%%"/>
  </TASKOPERATIONS>

  <RESIDUE_SELECTORS>
    <Task name="resselector" fixed="0" packable="0" designable="1" task_operations="mutate_resfile"/>
    <Neighborhood name="bubble" selector="resselector" distance="8.0"/>
    <PrimarySequenceNeighborhood name="bubble_adjacent" selector="bubble" lower="1" upper="1"/>
    <StoredResidueSubset name="restore_neighbor_shell" subset_name="neighbor_shell"/>
    <Not name="everythingelse" selector="restore_neighbor_shell"/>
  </RESIDUE_SELECTORS>

  <TASKOPERATIONS>
    <OperateOnResidueSubset name="repackonly" selector="restore_neighbor_shell">
      <RestrictToRepackingRLT/>
    </OperateOnResidueSubset>
    <OperateOnResidueSubset name="norepack" selector="everythingelse">
      <PreventRepackingRLT/>
    </OperateOnResidueSubset>
    <UseMultiCoolAnnealer name="multicool" states="6"/>
    <ExtraChiCutoff name="extrachizero" extrachi_cutoff="0"/>
    <InitializeFromCommandline name="commandline_init"/>
    <RestrictToRepacking name="restrict_to_repacking"/>
  </TASKOPERATIONS>

  <FILTERS>
  </FILTERS>

  <MOVERS>
    <StoreResidueSubset name="neighbor_shell_storer" subset_name="neighbor_shell" residue_selector="bubble_adjacent"/>

    <AddConstraintsToCurrentConformationMover name="addcst" use_distance_cst="1" coord_dev="0.5"
        min_seq_sep="0" max_distance="9" CA_only="1" bound_width="0.0" cst_weight="0.0"/>
    <ClearConstraintsMover name="clearcst"/>

    <!-- max_iter=5000, abs_score_convergence_threshold=200.0 match the reference tutorial's
         benchmarked run_example_*.py values (max_minimization_iter/abs_score_convergence_thresh);
         these are NOT arbitrary and shouldn't be tightened without re-benchmarking. -->
    <MinMover name="minimize" scorefxn="fa_talaris2014_cst" chi="1" bb="1" type="lbfgs_armijo_nonmonotone"
        tolerance="0.000001" max_iter="5000" abs_score_convergence_threshold="200.0"/>

    <PackRotamersMover name="repack" scorefxn="fa_talaris2014" task_operations="commandline_init,repackonly,norepack,multicool"/>
    <PackRotamersMover name="mutate" scorefxn="fa_talaris2014" task_operations="commandline_init,mutate_resfile,norepack,multicool"/>

    <ReportToDB name="dbreport" batch_description="interface_ddG" database_name="ddG.db3">
      <ScoreTypeFeatures/>
      <ScoreFunctionFeatures scorefxn="fa_talaris2014"/>
      <StructureScoresFeatures scorefxn="fa_talaris2014"/>
    </ReportToDB>

    <ReportToDB name="structreport" batch_description="interface_ddG_struct" database_name="struct.db3">
      <PoseConformationFeatures/>
      <PdbDataFeatures/>
      <JobDataFeatures/>
      <ResidueFeatures/>
      <PoseCommentsFeatures/>
      <ProteinResidueConformationFeatures/>
      <ResidueConformationFeatures/>
    </ReportToDB>

    <SavePoseMover name="save_wt_bound_pose" restore_pose="0" reference_name="wt_bound_pose"/>
    <SavePoseMover name="save_backrub_pose" restore_pose="0" reference_name="backrubpdb"/>
    <SavePoseMover name="restore_backrub_pose" restore_pose="1" reference_name="backrubpdb"/>

    <!-- db_reporter="dbreport" is REQUIRED: InterfaceDdGMover clones `dbreport` four
         times internally (bound_wt_/unbound_wt_/bound_mut_/unbound_mut_ + batch_description)
         and applies each clone against the corresponding pose. This is the only place
         ddG.db3 rows actually get written; `dbreport` is never <Add>ed directly. -->
    <InterfaceDdGMover name="int_ddG_mover" wt_ref_savepose_mover="save_wt_bound_pose"
        chain_name="%%chainstomove%%" db_reporter="dbreport" scorefxn="fa_talaris2014"/>

    <ScoreMover name="apply_score" scorefxn="fa_talaris2014_cst" verbose="0"/>

    <!-- Runs once per backrub trajectory checkpoint (trajectory_stride below). Order matters:
         repack+minimize the backrub-perturbed WT, ddG-relevant save, restore to the pre-repack
         backrub pose, THEN mutate+repack+minimize, THEN compute ddG (bound-unbound x wt-mut). -->
    <ParsedProtocol name="finish_ddg_post_backrub">
      <Add mover_name="save_backrub_pose"/>
      <Add mover_name="structreport"/>

      <Add mover_name="repack"/>

      <Add mover_name="addcst"/>
      <Add mover_name="minimize"/>
      <Add mover_name="clearcst"/>

      <Add mover_name="save_wt_bound_pose"/>
      <Add mover_name="structreport"/>
      <Add mover_name="restore_backrub_pose"/>

      <Add mover_name="mutate"/>

      <Add mover_name="addcst"/>
      <Add mover_name="minimize"/>
      <Add mover_name="clearcst"/>
      <Add mover_name="structreport"/>

      <Add mover_name="int_ddG_mover"/>
    </ParsedProtocol>

    <!-- trajectory_apply_mover is what actually invokes finish_ddg_post_backrub; it is NOT
         reachable from <PROTOCOLS> below. trajectory_stride == ntrials means "only at the end". -->
    <BackrubProtocol name="backrub" mc_kt="1.2" ntrials="%%backrubntrials%%"
        pivot_residue_selector="restore_neighbor_shell"
        task_operations="restrict_to_repacking,commandline_init,extrachizero"
        recover_low="0" trajectory_stride="%%backrubntrials%%"
        trajectory_apply_mover="finish_ddg_post_backrub"/>
  </MOVERS>

  <PROTOCOLS>
    <Add mover_name="addcst"/>
    <Add mover_name="apply_score"/> <!-- Necessary to initialize neighbor graph -->
    <Add mover_name="neighbor_shell_storer"/>

    <Add mover_name="minimize"/>
    <Add mover_name="clearcst"/>

    <Add mover_name="backrub"/>
  </PROTOCOLS>

  <OUTPUT/>
</ROSETTASCRIPTS>
